# From @BotFather
BOT_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your GitHub Pages URL, e.g. https://yourname.github.io/vamios-bingo
WEBAPP_URL=

# Random long string used to sign short-lived web app auth tokens
JWT_SECRET=

# Telegram chat/channel ID where deposit/withdraw requests get posted for admin approval
ADMIN_CHAT_ID=

# --- Railway-specific ---
# Railway sets PORT automatically — you don't need to set this yourself.
# PORT=

# Set to "true" to run in webhook mode instead of polling (recommended
# on Railway once you have a public domain assigned to this service).
USE_WEBHOOK=false

# Only needed if USE_WEBHOOK=true and you want to override the domain.
# If left blank, Railway's own RAILWAY_PUBLIC_DOMAIN is used automatically
# (available once you enable public networking on this service).
WEBHOOK_DOMAIN=
