# Supabase project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=

# Service role key — Settings > API > service_role (secret!)
# NEVER put this in the frontend or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Railway-specific ---
# Railway sets PORT automatically — you don't need to set this yourself.
# PORT=
